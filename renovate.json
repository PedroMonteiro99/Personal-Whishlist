{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "Europe/Lisbon",
  "schedule": ["before 10am on Monday"],
  "labels": ["dependencies"],
  "assignees": ["PedroMonteiro99"],
  "reviewers": ["PedroMonteiro99"],
  "rebaseWhen": "conflicted",
  "semanticCommits": "enabled",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "📦 Dependency Dashboard",
  "packageRules": [
    {
      "description": "Group TypeScript type definitions",
      "matchPackageNames": ["@types/**"],
      "groupName": "TypeScript definitions",
      "addLabels": ["types"],
      "commitMessageTopic": "update TypeScript definitions"
    },
    {
      "description": "Next.js, React e o config de lint andam sempre juntos: o Next 15 fixa a versão de React que suporta, e os @types têm de acompanhar",
      "matchPackageNames": [
        "next",
        "react",
        "react-dom",
        "eslint-config-next",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "Next.js e React",
      "addLabels": ["framework"],
      "commitMessageTopic": "update {{depName}} to v{{newVersion}}",
      "commitMessageSuffix": "(next/react)"
    },
    {
      "description": "Tailwind CSS v4: o plugin de PostCSS tem de acompanhar o core",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/postcss"],
      "groupName": "Tailwind CSS",
      "addLabels": ["ui"],
      "commitMessageTopic": "update {{depName}} to v{{newVersion}}",
      "commitMessageSuffix": "(tailwind)"
    },
    {
      "description": "Primitivos Radix por trás do shadcn/ui (COMP-002)",
      "matchPackageNames": ["@radix-ui/**"],
      "groupName": "Radix UI",
      "addLabels": ["ui"],
      "commitMessageTopic": "update {{depName}} to v{{newVersion}}",
      "commitMessageSuffix": "(radix)"
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "addLabels": ["automerge"]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["github-actions"]
    },
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update"],
      "dependencyDashboardApproval": true,
      "commitMessageTopic": "{{depName}} to v{{newVersion}}",
      "commitMessageSuffix": "(MAJOR) ⬆️"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "addLabels": ["security"]
  },
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 11am on Monday"]
  },
  "forkProcessing": "enabled"
}
